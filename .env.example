# Milestones 1–2 run without environment variables or external service accounts.
# Copy this file to .env.local when configuring later milestones.
# Values below are intentionally blank and are NOT wired into the app yet.

# Milestone 3: Supabase project URL and browser-safe publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Milestone 8: server-only OpenAI credential. Never add NEXT_PUBLIC_ to secrets.
OPENAI_API_KEY=

# Service-role keys, portal credentials, vault passphrases, and recovery keys
# must never be added to this example, committed, or exposed in client code.
