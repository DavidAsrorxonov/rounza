# The public landing page and demo work without configuration.
# Copy to .env.local for accounts. See docs/accounts-setup.md.

# Canonical app origin; use the same hostname in your browser and redirect allowlist.
SITE_URL=http://localhost:3000

# Supabase project origin and publishable key (sb_publishable_...).
# Both are read on the server. A publishable key does NOT bypass row-level security.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Milestone 8 only; not consumed yet. Never prefix a secret with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Google client secrets belong in Supabase's provider settings, not this app.
# Do not commit service-role keys, real credentials, vault passphrases, or recovery keys.
